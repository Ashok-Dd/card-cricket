# Copy to .env and fill in real values for your machine/environment.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/card_cricket?schema=public"
# Managed Redis providers (e.g. Upstash) typically require TLS on this URL —
# use `rediss://` (double s), not `redis://`, or the connection just hangs
# and fails silently. Local/self-hosted Redis is usually plain `redis://`.
REDIS_URL="redis://localhost:6379"
# Set to true only on machines without a working Redis (uses an in-memory
# mock instead) — leave unset/false in production and anywhere Redis works.
REDIS_MOCK=false
JWT_SECRET="change-me"
JWT_EXPIRES_IN_SECONDS=604800
ECONOMY_WELCOME_BONUS_COINS=1000
ECONOMY_MATCH_WIN_BONUS_COINS=200
PORT=3000
